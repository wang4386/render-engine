{
    admin off
    auto_https off
}

:{$PORT:10000} {
    # 1. Health check endpoint for external ping / uptime bot
    handle /health {
        respond "OK" 200
    }

    # 2. Web Terminal (ttyd with tmux persistence)
    handle /shell* {
        reverse_proxy 127.0.0.1:7681 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            flush_interval -1
        }
    }

    # 3. sing-box VLESS WebSocket Ingress (Optional proxy)
    handle /vless-ws* {
        reverse_proxy 127.0.0.1:20808 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    # Default fallback: Welcome status prompt
    handle {
        respond "render-engine is running. Access /shell/ for web terminal, or /health for uptime probe." 200
    }
}
